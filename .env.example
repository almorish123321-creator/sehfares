# ============================================================
#  Seha Sick Leave — Environment Variables
# ============================================================
# Copy this file to `.env` for local development.
# NEVER commit `.env` (it is already in .gitignore).
#
# On Render: Dashboard -> your Web Service -> Environment -> Add Environment Variable
#            (add each line below as its own key/value pair)
# ============================================================


# ---------- REQUIRED ----------
# The server refuses to start if any of these three are missing.

# Telegram Bot token from @BotFather (/newbot or /token)
TELEGRAM_BOT_TOKEN=

# Numeric Telegram chat id of the owner/admin account (run /mychatid on the bot)
ADMIN_CHAT_ID=

# Master password for the web admin dashboard.
# Use a long random string, e.g. generate one with:  openssl rand -hex 32
# This replaces the old hardcoded password and is compared on the SERVER only.
ADMIN_MASTER_TOKEN=


# ---------- RECOMMENDED ----------

# Public URL of this service. On Render this is auto-filled via RENDER_EXTERNAL_URL,
# so you normally do NOT need to set it there. Set it for local/docker runs.
# WEB_APP_URL=https://your-service.onrender.com

# Telegram username of the owner (without @). Used for the "contact the owner" button.
ADMIN_USERNAME=

# Display name of the owner account shown in the admin dashboard.
# If unset, the admin username is used.
ADMIN_NAME=

# Extra Telegram usernames allowed to run admin bot commands (comma separated, no @).
# ADMIN_USERNAMES=first_admin,second_admin

# Telegram channel id used for report backup forwarding (optional).
# TELEGRAM_CHANNEL_ID=

# Bot username (without @) used to build referral links.
# Optional: it is detected automatically via getMe() at runtime.
# BOT_USERNAME=

# Port the Express server listens on (Render sets this automatically).
PORT=3000

# NODE_ENV=production


# ---------- OPTIONAL INTEGRATIONS ----------

# Short.io — used for the QR-code short links inside generated PDFs.
# Domain is configured separately (default: sehaedu.s.gy).
SHORTIO_API_KEY=
# SHORTIO_DOMAIN=sehaedu.s.gy

# Base URL used when SHORTIO_API_KEY is NOT set. The QR code then points at this
# app's own /<service-code> route (which redirects to the inquiry page) instead of
# a Short.io link that was never created and would return 404.
# Defaults to WEB_APP_URL / RENDER_EXTERNAL_URL, so you normally do not set it.
# FALLBACK_SHORT_BASE=https://your-service.onrender.com

# Public URL printed on the PDF QR code / clickable link.
# INQUIRY_URL=https://seha-sa.s.gy/inquiries

# Directory for the persistent database files (Render disk mount path).
# DATA_DIR=/data


# ---------- TEST / TOOLING ONLY ----------

# Used by the deploy script (auto-deploy-github.js).
# Needs a GitHub PAT with "repo" scope.
# GITHUB_TOKEN=
# GITHUB_USERNAME=
# REPO_NAME=

# Used by the local test scripts (test_*.js) as a sandbox owner account.
# TEST_OWNER_ID=100000000
# TEST_OWNER_USERNAME=test_admin

# Chrome/Chromium binary used by Puppeteer to render the PDF.
# On Render this is installed by `npm run build`; set it only for custom images.
# PUPPETEER_EXECUTABLE_PATH=
